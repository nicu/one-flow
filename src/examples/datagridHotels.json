[
  {
    "id": "page-root",
    "type": "flex",
    "properties": {
      "flexDirection": "column",
      "gap": "16px",
      "padding": "20px",
      "width": "100%"
    },
    "children": [
      {
        "id": "breadcrumbs-1",
        "type": "breadcrumbs",
        "properties": {
          "breadcrumbs": ["Admin", "Hotels", "Manage"]
        }
      },
      {
        "id": "header-row",
        "type": "flex",
        "properties": {
          "flexDirection": "row",
          "justifyContent": "space-between",
          "alignItems": "center",
          "gap": "12px"
        },
        "children": [
          {
            "id": "title-text",
            "type": "text",
            "properties": {
              "text": "Hotel Back Office",
              "fontSize": "24px",
              "fontWeight": "bold"
            }
          },
          {
            "id": "actions-row",
            "type": "flex",
            "properties": {
              "flexDirection": "row",
              "gap": "8px"
            },
            "children": [
              {
                "id": "save-button",
                "type": "button",
                "properties": {
                  "buttonText": "Save Changes",
                  "buttonColor": "#1976d2",
                  "buttonTextColor": "#ffffff"
                }
              },
              {
                "id": "add-button",
                "type": "button",
                "properties": {
                  "buttonText": "Add Hotel",
                  "buttonColor": "#4caf50",
                  "buttonTextColor": "#ffffff"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "tabs-row",
        "type": "tabs",
        "properties": {
          "dataBinding": { "modelId": "hotel", "collectionId": "hotel" },
          "tabField": "available"
        }
      },
      {},
      {
        "id": "datagrid-hotels-1",
        "type": "datagrid",
        "properties": {
          "width": "100%",
          "height": "500px",
          "pageSize": 6,
          "dataBinding": { "collectionId": "hotel", "modelId": "hotel" },
          "columns": [
            { "field": "id", "headerName": "ID", "width": 120 },
            { "field": "name", "headerName": "Name", "width": 240 },
            { "field": "price", "headerName": "Price", "width": 120 },
            { "field": "rating", "headerName": "Rating", "width": 120 },
            { "field": "location", "headerName": "Location", "width": 180 },
            {
              "field": "available",
              "headerName": "Available",
              "width": 120,
              "render": "chip"
            }
          ]
        }
      }
    ]
  }
]
