[
  {
    "id": "form-root",
    "type": "form",
    "properties": {
      "dataBinding": { "modelId": "user" }
    },
    "children": [
      {
        "id": "label-title",
        "type": "text",
        "properties": {
          "text": "User profile",
          "fontSize": "18px",
          "fontWeight": "700"
        }
      },
      {
        "id": "first-name",
        "type": "input",
        "properties": {
          "placeholder": "Full name",
          "dataBinding": { "fieldId": "name" },
          "label": "Name",
          "validations": [{ "type": "required" }]
        }
      },
      {
        "id": "location",
        "type": "input",
        "properties": {
          "placeholder": "Location",
          "dataBinding": { "fieldId": "location" },
          "label": "Location"
        }
      },
      {
        "id": "email",
        "type": "input",
        "properties": {
          "placeholder": "Email",
          "dataBinding": { "fieldId": "email" },
          "label": "Email"
        }
      },
      {
        "id": "submit-btn",
        "type": "button",
        "properties": { "buttonText": "Save" }
      }
    ]
  }
]
