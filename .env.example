### Example environment variables for OneFlow server
# Point to your local Ollama Desktop HTTP API (default Ollama port is 11434)
LLM_BASE_URL=http://localhost:11434
# Model name installed in Ollama (adjust to a model you have locally, e.g. qwen3-coder:30b)
# Using `qwen3-coder:30b` by default per your setup
LLM_MODEL=qwen3-coder:30b
# Optional: if you proxy through another service that requires a key
LLM_API_KEY=
# Server port
PORT=4040